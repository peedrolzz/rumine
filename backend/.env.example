DATABASE_URL="postgresql://rumine:rumine@localhost:5432/rumine"

# Endereço do front. É a origem aceita pela API (CORS e proteção CSRF) e a base do link do
# e-mail de confirmação de cadastro.
# FRONTEND_ORIGIN="http://localhost:5173"

# Domínios de e-mail aceitos no cadastro, separados por vírgula. Padrão do MVP: só discentes.
# DOMINIOS_EMAIL_PERMITIDOS="alunos.utfpr.edu.br"

# Só desenvolvimento: finge um usuário logado, sem passar pelo login. ADMIN, OPERADOR, USUARIO
# ou MESTRE. Exige rodar o seed (npm run seed) e IGNORA o login real enquanto estiver definido:
# deixe comentado para testar cadastro e login de verdade. Ignorado com NODE_ENV=production.
# DEV_USUARIO=ADMIN

# Pasta onde ficam as declarações de vínculo enviadas (só desenvolvimento; ignorada pelo Git).
# Em produção entra um serviço de armazenamento privado no lugar do disco.
# ARMAZENAMENTO_DIR="armazenamento-privado"

# Provedor de pagamento da recarga (HU-05). Por enquanto só o simulado (plano B do ADR-006); o
# provedor real (fora do MVP) entraria no mesmo contrato. O segredo assina os avisos (webhooks) do provedor:
# em produção é OBRIGATÓRIO e deve ser longo e aleatório. Em desenvolvimento há um padrão.
# PAGAMENTO_WEBHOOK_SEGREDO="troque-por-um-segredo-longo-e-aleatorio"
